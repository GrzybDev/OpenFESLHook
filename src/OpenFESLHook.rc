#include <windows.h>

#include "resource.h"

IDR_LAUNCHER_MANIFEST RT_MANIFEST "launcher.manifest"

// The captions come from the translation catalogues when the dialog opens, so one layout serves every language.
IDD_LAUNCHER DIALOGEX 0, 0, 300, 238
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
	CONTROL "", IDC_MODE_PLAY, "BUTTON",
	        BS_AUTORADIOBUTTON | BS_PUSHLIKE | BS_MULTILINE | BS_CENTER | BS_VCENTER | WS_GROUP | WS_TABSTOP, 10, 8, 135, 36
	CONTROL "", IDC_MODE_HOST, "BUTTON",
	        BS_AUTORADIOBUTTON | BS_PUSHLIKE | BS_MULTILINE | BS_CENTER | BS_VCENTER | WS_TABSTOP, 155, 8, 135, 36

	LTEXT "", IDC_ACCOUNT_LABEL, 10, 54, 55, 9
	EDITTEXT IDC_ACCOUNT, 70, 52, 220, 13, ES_AUTOHSCROLL | WS_GROUP | WS_TABSTOP
	LTEXT "", IDC_PASSWORD_LABEL, 10, 72, 55, 9
	EDITTEXT IDC_PASSWORD, 70, 70, 220, 13, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP
	CONTROL "", IDC_REMEMBER, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 70, 88, 150, 10
	CONTROL "", IDC_LINKS, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 70, 101, 220, 10
	LTEXT "", IDC_LINKS_NOTE, 82, 113, 208, 16

	LTEXT "", IDC_LANGUAGE_LABEL, 10, 134, 55, 9
	COMBOBOX IDC_LANGUAGE, 70, 132, 150, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

	LTEXT "", IDC_MAP_LABEL, 10, 152, 55, 9
	COMBOBOX IDC_MAP, 70, 150, 150, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	CONTROL "", IDC_RANKED, "BUTTON", BS_AUTOCHECKBOX | WS_TABSTOP, 70, 168, 150, 10

	LTEXT "", IDC_STATUS, 10, 192, 165, 38
	DEFPUSHBUTTON "", IDOK, 182, 217, 52, 14
	PUSHBUTTON "", IDCANCEL, 240, 217, 52, 14
END
